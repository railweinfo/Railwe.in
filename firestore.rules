rules_version = '2';

// Firestore security rules for the NDA Register app.
//
// Each signed-in user's data lives at: users/{uid}/ndaRegister/data
// A user may only read or write their OWN document — this is what makes
// the "private per Google account" data model actually enforced on the
// server, not just assumed by the client code.
//
// Deploy with: firebase deploy --only firestore:rules
// (see README.md for full setup instructions)

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/ndaRegister/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
